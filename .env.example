# Ejemplo de variables de entorno para desarrollo local o despliegue
# Renombrá este archivo a .env para personalizar valores locales (nunca subas .env a Git)

# Clave secreta de Django (usar una cadena larga y aleatoria en producción)
SECRET_KEY=django-insecure-ejemplo-clave-local-de-desarrollo

# Modo de depuración (1 para desarrollo local, 0 para producción)
DEBUG=1

# Hosts permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Base de datos (opcional: por defecto usa SQLite en desarrollo)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/blog_db
